mdl 1.10;

import ::df::*;
using ::wildcard_import_helper import *;

export material Default(
    color tint = make_tint(0.8, 0.7, 0.6)
) = material(
    surface: material_surface(
        scattering: df::diffuse_reflection_bsdf(tint: tint)
    )
);
