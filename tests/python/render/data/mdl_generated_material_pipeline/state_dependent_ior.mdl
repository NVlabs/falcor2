mdl 1.10;

import ::df::*;
import ::state::*;

export material Default() = material(
    surface: material_surface(
        scattering: df::diffuse_reflection_bsdf()
    ),
    ior: color(
        1.0
        + state::texture_coordinate(0).x
        + 0.25 * state::texture_coordinate(1).x
    )
);
