<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <constant name="surface_weight" type="float">
    <input name="value" type="float" value="1.0" />
  </constant>
  <oren_nayar_diffuse_bsdf name="surface_diffuse" type="BSDF">
    <input name="weight" type="float" nodename="surface_weight" />
    <input name="color" type="color3" value="0.6, 0.5, 0.4" />
    <input name="roughness" type="float" value="0.8" />
  </oren_nayar_diffuse_bsdf>
  <surface name="surface" type="surfaceshader">
    <input name="bsdf" type="BSDF" nodename="surface_diffuse" />
  </surface>
  <texcoord name="dust_texcoord" type="vector2">
    <input name="index" type="integer" value="1" />
  </texcoord>
  <image name="dust_image" type="vector3">
    <input name="file" type="filename" uniform="true" value="../../../data/assets/cornell-box/preview.png" />
    <input name="texcoord" type="vector2" nodename="dust_texcoord" />
  </image>
  <extract name="dust_mask" type="float">
    <input name="in" type="vector3" nodename="dust_image" />
    <input name="index" type="integer" value="0" />
  </extract>
  <output name="surface_output" type="surfaceshader" nodename="surface" />
  <output name="dust_mask_output" type="float" nodename="dust_mask" />
</materialx>
