<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodedef name="ND_inner_diffuse" node="inner_diffuse" nodegroup="pbr">
    <input name="color" type="color3" value="0.5, 0.5, 0.5" />
    <input name="normal" type="vector3" value="0, 0, 1" />
    <output name="out" type="BSDF" />
  </nodedef>
  <nodegraph name="IM_inner_diffuse" nodedef="ND_inner_diffuse">
    <oren_nayar_diffuse_bsdf name="diffuse" type="BSDF">
      <input name="color" type="color3" interfacename="color" />
      <input name="normal" type="vector3" interfacename="normal" />
    </oren_nayar_diffuse_bsdf>
    <output name="out" type="BSDF" nodename="diffuse" />
  </nodegraph>
  <nodedef name="ND_outer_diffuse" node="outer_diffuse" nodegroup="pbr">
    <input name="color" type="color3" value="0.5, 0.5, 0.5" />
    <input name="normal" type="vector3" value="0, 0, 1" />
    <output name="out" type="BSDF" />
  </nodedef>
  <nodegraph name="IM_outer_diffuse" nodedef="ND_outer_diffuse">
    <inner_diffuse name="inner" type="BSDF">
      <input name="color" type="color3" interfacename="color" />
      <input name="normal" type="vector3" interfacename="normal" />
    </inner_diffuse>
    <output name="out" type="BSDF" nodename="inner" />
  </nodegraph>
  <outer_diffuse name="top_lobe" type="BSDF">
    <input name="color" type="color3" value="0.2, 0.1, 0.05" />
    <input name="normal" type="vector3" value="0, 1, 0" />
  </outer_diffuse>
  <outer_diffuse name="base_lobe" type="BSDF">
    <input name="color" type="color3" value="0.1, 0.4, 0.8" />
    <input name="normal" type="vector3" value="0, 0.6, 0.8" />
  </outer_diffuse>
  <layer name="layered" type="BSDF">
    <input name="top" type="BSDF" nodename="top_lobe" />
    <input name="base" type="BSDF" nodename="base_lobe" />
  </layer>
  <surface name="surface" type="surfaceshader">
    <input name="bsdf" type="BSDF" nodename="layered" />
  </surface>
  <surfacematerial name="NestedDistinctNormals" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="surface" />
  </surfacematerial>
</materialx>
