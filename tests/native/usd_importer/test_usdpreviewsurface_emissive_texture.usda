#usda 1.0
(
    defaultPrim = "Root"
)

def Xform "Root"
{
    def Scope "Looks"
    {
        def Material "Mat"
        {
            token outputs:surface.connect = </Root/Looks/Mat/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:emissiveColor.connect = </Root/Looks/Mat/EmissiveTexture.outputs:rgb>
                token outputs:surface
            }

            def Shader "EmissiveTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @emissive.png@
                color3f outputs:rgb
            }
        }
    }

    def Mesh "Triangle"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        rel material:binding = </Root/Looks/Mat>
    }
}
