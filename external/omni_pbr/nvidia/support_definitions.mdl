export float remap(
    float a=0. [[
        anno::description("Input value in the source range.")
    ]],
    float start_old=0. [[
        anno::description("Lower bound of the source range.")
    ]],
    float end_old=1. [[
        anno::description("Upper bound of the source range.")
    ]],
    float start_new=0. [[
        anno::description("Lower bound of the destination range.")
    ]],
    float end_new=1. [[
        anno::description("Upper bound of the destination range.")
    ]])
[[
    anno::display_name("Remap"),
    anno::description("Remaps the input from [start_old, end_old] into [start_new, end_new]."),
    anno::author("NVIDIA Corporation"),
    anno::in_group("Math", "Functions", "Remap"),
    icon(".icons/Remap.svg"),
    anno::ui_order(680)
]]
{ return start_new + (a - start_old) * (end_new - start_new) / (end_old - start_old); }

