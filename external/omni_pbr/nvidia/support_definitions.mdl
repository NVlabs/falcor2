float2 r2d(float2 x, float theta)
{
    theta *= math::acos(-1.0) * 2.0;
    return float2(
        math::cos(theta) * x[0] + math::sin(theta) * x[1],
        math::cos(theta) * x[1] - math::sin(theta) * x[0]);
}

export float3 rotate_around_x(
    float3 p [[
        anno::description("Point to rotate.")
    ]],
    float theta [[
        anno::description("Rotation amount in turns, where 1.0 is a full 360-degree rotation.")
    ]])
[[
    anno::display_name("Rotate Around X"),
    anno::description("Rotates a 3D point around the X axis by the input angle."),
    anno::author("NVIDIA Corporation"),
    anno::in_group("Math", "Transform", "Rotation"),
    icon(".icons/rotation.svg"),
    anno::ui_order(1024)
]]
{
    float2 v = r2d(float2(p.y, p.z), theta);
    return float3(p.x, v[0], v[1]);
}

