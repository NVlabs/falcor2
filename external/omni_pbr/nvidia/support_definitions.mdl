// operator nodes
// Add
export int add(int a=0, int b=0)
[[
    anno::display_name("Add"),
    anno::description("Adds the two inputs and returns the result."),
    anno::author("NVIDIA Corporation"),
    anno::in_group("Math", "Operators", "Add"),
    icon(".icons/Add.svg"),
    anno::ui_order(300)
]]
{ return a+b; }

export float add(float a=0.0, float b=0.0)
[[
    anno::display_name("Add"),
    anno::description("Adds the two inputs and returns the result."),
    anno::author("NVIDIA Corporation"),
    anno::in_group("Math", "Operators", "Add"),
    icon(".icons/Add.svg"),
    anno::ui_order(301)
]]
{ return a+b; }

export float2 add(float2 a=float2(0.0), float2 b=float2(0.0))
[[
    anno::display_name("Add"),
    anno::description("Adds the two inputs and returns the result. The operation is performed per component (x and y)."),
    anno::author("NVIDIA Corporation"),
    anno::in_group("Math", "Operators", "Add"),
    icon(".icons/Add.svg"),
    anno::ui_order(302)
]]
{ return a+b; }

