export float2 transform_st(
    float rotation = 0.0 [[
        anno::description("Rotation angle in radians.")
    ]],
    float2 translation = float2(0.0) [[
        anno::description("Translation offset applied after rotation and scaling.")
    ]],
    float2 scale = float2(1.0) [[
        anno::description("Scale factor applied per coordinate axis.")
    ]],
    float2 st = float2(0.0) [[
        anno::description("Input 2D coordinate to transform.")
    ]]
)
[[
    anno::display_name("Transform 2D"),
    anno::description("Applies rotation, scaling, and translation to a 2D coordinate."),
    anno::author("NVIDIA Corporation"),
    anno::in_group("Math", "Transform"),
    icon(".icons/transform.svg"),
    anno::ui_order(1019)
]]
{
    float s = math::sin(rotation);
	float c = math::cos(rotation);
	float2 st_t=st;
	st_t = float2(s*st_t.x+c*st_t.y,s*st_t.y-c*st_t.x);
	return st_t*scale+ translation;
}

export color biased_color_blend(
    float w1 = 0.0 [[
        anno::description("Weight for the first input color.")
    ]],
    color c1 = color(0.0) [[
        anno::description("First input color.")
    ]],
    float w2 = 0.0 [[
        anno::description("Weight for the second input color.")
    ]],
    color c2 = color(0.0) [[
        anno::description("Second input color.")
    ]],
    float w3 = 0.0 [[
        anno::description("Weight for the third input color.")
    ]],
    color c3 = color(0.0) [[
        anno::description("Third input color.")
    ]],
    color mean = color(0.5) [[
        anno::description("Expected average color used to preserve contrast in the biased blend.")
    ]]
)
[[
    anno::display_name("Biased color blend"),
    anno::description("Blends up to three colors using weights; set mean to the expected average to preserve contrast when mixing textures."),
    anno::author("NVIDIA Corporation"),
    anno::in_group("Math", "Functions", "Blend"),
    icon(".icons/biased_color_blend.svg"),
    anno::ui_order(539)
]]
{
	color o=w1*c1+w2*c2+w3*c3;
	float s=w1+w2+w3;
	float s2=w1*w1+w2*w2+w3*w3;
return mean + (o-s*mean)/   math::sqrt(s2);
}


