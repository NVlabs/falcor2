[[
    anno::display_name("Add"),
    anno::description("Adds the two inputs and returns the result. The operation is performed per component (x, y, and z)."),
    anno::author("NVIDIA Corporation"),
    anno::in_group("Math", "Operators", "Add"),
    icon(".icons/Add.svg"),
    anno::ui_order(303)
]]
{ return a+b; }

