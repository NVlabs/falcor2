module [[
    anno::version( 1, 2, 0),
    anno::display_name("NVIDIA support definitions")
]];

export annotation icon(string path);


export float data_lookup_float(
    uniform string name [[
        anno::description("Scene data attribute name to look up on the target mesh.")
    ]],
    float default_value = float() [[
        anno::description("Fallback value returned when the named scene data is not present on the target mesh.")
    ]]
) [[
    anno::display_name("Data lookup float"),
    anno::description("Looks up mesh scene data by name and returns it when present; otherwise returns the provided default value."),
    anno::author("NVIDIA Corporation"),
    anno::in_group("State and Primvars", "Data Lookup", "Varying"),
    icon(".icons/data_lookup.svg")
]]
{
    return scene::data_lookup_float(name, default_value);
}

