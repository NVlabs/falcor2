    ]],
    float4 end_old=1. [[
        anno::description("Upper bound of the source range per component.")
    ]],
    float4 start_new=0. [[
        anno::description("Lower bound of the destination range per component.")
    ]],
    float4 end_new=1. [[
        anno::description("Upper bound of the destination range per component.")
    ]])
[[
    anno::display_name("Remap"),
    anno::description("Remaps the input from [start_old, end_old] into [start_new, end_new]. The operation is performed per component (x, y, z, and w)."),
    anno::author("NVIDIA Corporation"),
    anno::in_group("Math", "Functions", "Remap"),
    icon(".icons/Remap.svg"),
    anno::ui_order(683)
]]
{ return start_new + (a - start_old) * (end_new - start_new) / (end_old - start_old); }
