export int condition(
    uniform bool x=true [[
        anno::description("Condition that selects which input to return.")
    ]],
    int a=0 [[
        anno::description("Value returned when the condition is true.")
    ]],
    int b=0 [[
        anno::description("Value returned when the condition is false.")
    ]]
)
[[
    anno::display_name("Condition?"),
    anno::description("Returns input a when the condition is true; otherwise returns input b."),
    anno::author("NVIDIA Corporation"),
    anno::in_group("Math", "Condition"),
    icon(".icons/condition.svg"),
    anno::ui_order(332)
]]
{ return x?a:b; }

