//***********************************************************************************************************************
// Conversions of texture_return
// All are hidden
export float4 texture_return_float4(
    texture_return a [[
        anno::description("Input texture sample container to unpack as float4 (r, g, b, mono).")
    ]])
[[
    anno::display_name("float4 from texture_return"),
    anno::description("Converts texture_return to float4 using tint RGB and mono as W."),
    anno::author("NVIDIA Corporation"),
    anno::hidden(),
    anno::in_group("Channel", "Float4"),
    icon(".icons/component_extract.svg"),
    anno::ui_order(10108)
]]
{ return float4(x(a),y(a),z(a),w(a)); }

export float3 texture_return_float3(
    texture_return a [[
        anno::description("Input texture sample container to unpack as float3 (r, g, b).")
    ]])
[[
    anno::display_name("float3 from texture_return"),
    anno::description("Converts texture_return to float3 using the tint RGB channels."),
    anno::hidden(),
    anno::author("NVIDIA Corporation"),
    anno::in_group("Channel", "Float3"),
    icon(".icons/component_extract.svg"),
    icon(".icons/component_extract.svg"),
    anno::ui_order(10109)
]]
{ return float3(x(a),y(a),z(a)); }

export color texture_return_color(
    texture_return a [[
        anno::description("Input texture sample container; tint RGB is returned as color.")
    ]])
[[
    anno::display_name("color from texture_return"),
    anno::description("Converts texture_return to color using the tint RGB channels."),
    anno::hidden(),
    anno::author("NVIDIA Corporation"),
    anno::in_group("Channel", "Color"),
    icon(".icons/component_extract.svg"),
    anno::ui_order(10110)
]]
{ return a.tint; }

export float texture_return_float(
    texture_return a [[
        anno::description("Input texture sample container; mono channel is returned.")
    ]])
[[
