mdl 1.4;

import ::anno::*;
export using ::base import texture_return;

module
[[
    anno::version( 1, 2, 0),
    anno::hidden(),
    anno::display_name("NVIDIA auxillary definitions")
]];

// Support functions to simplify conversions between vector types with swizzles
// Supported argument types: float2, float3, float4, color, texture_return (as RGB and RGBA)
// Supported return types: float, float2, float3 color


export annotation icon(string path);


//***********************************************************************************************************************
// Constructor wrappers

export float construct_float(
    texture_return a [[
        anno::description("Input texture sample container; the mono channel is returned.")
    ]])
[[
    anno::display_name("Float from texture_return"),
    anno::description("Constructs a float from the mono channel of a texture_return value."),
    anno::author("NVIDIA Corporation"),
    anno::in_group("Constructor", "Float"),
    icon(".icons/constructor.svg"),
    anno::ui_order(10000)
]]
{ return a.mono; }

export color construct_color(
    float a [[
        anno::description("Scalar value replicated into all color channels.")
    ]])
[[
    anno::display_name("Color from float"),
    anno::description("Constructs a color from a single float value."),
    anno::author("NVIDIA Corporation"),
    anno::in_group("Constructor", "Color"),
    icon(".icons/constructor.svg"),
    anno::ui_order(10001)
]]
{ return color(a); }

export color construct_color(
    float3 a [[
        anno::description("RGB source components.")
    ]])
[[
    anno::display_name("Color from float3"),
    anno::description("Constructs a color from a float3 value."),
    anno::author("NVIDIA Corporation"),
    anno::in_group("Constructor", "Color"),
    icon(".icons/constructor.svg"),
    anno::ui_order(10002)
]]
{ return color(a); }

export color construct_color(
    float r [[
        anno::description("Red channel value.")
    ]],
    float g [[
        anno::description("Green channel value.")
    ]],
    float b [[
        anno::description("Blue channel value.")
    ]])
[[
    anno::display_name("Color from floats"),
    anno::description("Constructs a color from explicit red, green, and blue components."),
    anno::author("NVIDIA Corporation"),
    anno::in_group("Constructor", "Color"),
    icon(".icons/constructor.svg"),
    anno::ui_order(10003)
]]
{ return color(r,g,b); }

export color construct_color(
    texture_return a [[
        anno::description("Input texture sample container; the tint (RGB) channels are returned.")
    ]])
[[
    anno::display_name("Color from texture_return"),
    anno::description("Constructs a color from the tint (RGB) channels of a texture_return value."),
    anno::author("NVIDIA Corporation"),
    anno::in_group("Constructor", "Color"),
    icon(".icons/constructor.svg"),
    anno::ui_order(10004)
]]
{ return a.tint; }

export float4 construct_float4(
    float x [[
        anno::description("X component value.")
    ]],
    float y [[
        anno::description("Y component value.")
    ]],
    float z [[
        anno::description("Z component value.")
    ]],
    float w [[
        anno::description("W component value.")
    ]])
[[
    anno::display_name("Float4 from floats"),
    anno::description("Constructs a float4 from explicit x, y, z, and w components."),
    anno::author("NVIDIA Corporation"),
    anno::in_group("Constructor", "Float4"),
    icon(".icons/constructor.svg"),
    anno::ui_order(10005)
]]
{ return float4(x,y,z,w); }

export float4 construct_float4(
    float3 xyz [[
        anno::description("Source xyz components.")
    ]],
    float w [[
        anno::description("W component value.")
    ]])
[[
    anno::display_name("Float4 from float3,float"),
    anno::description("Constructs a float4 from a float3 xyz value and a separate w component."),
    anno::author("NVIDIA Corporation"),
    anno::in_group("Constructor", "Float4"),
    icon(".icons/constructor.svg"),
    anno::ui_order(10006)
]]
{ return float4(xyz.x,xyz.y,xyz.z,w); }

export float3 construct_float3(
    color a [[
        anno::description("Input color whose RGB channels are converted to float3.")
