{
    "name": "falcor2",
    "version-string": "0.0.1",
    "dependencies": [
        "usd",
        "mikktspace",
        "opensubdiv",
        "libjpeg-turbo",
        "libpng",
        "openexr",
        "asmjit"
    ],
    "features": {
        "usd-fbx": {
            "description": "Experimental Adobe FBX plugin for core-only USD (downloads FBX SDK 2020.3.11)",
            "dependencies": [
                {
                    "name": "usd-fileformat-plugins",
                    "default-features": false,
                    "features": [
                        "fbx"
                    ]
                }
            ]
        },
        "webrtc": {
            "description": "Enable WebRTC media transport",
            "dependencies": [
                {
                    "name": "libdatachannel",
                    "default-features": false,
                    "features": [
                        "srtp"
                    ]
                }
            ]
        },
        "crashpad": {
            "description": "Enable Crashpad integration",
            "dependencies": [
                "crashpad"
            ]
        }
    },
    "builtin-baseline": "ce613c41372b23b1f51333815feb3edd87ef8a8b",
    "vcpkg-configuration": {
        "overlay-triplets": [
            "./cmake/vcpkg-triplets",
            "./external/slangpy/external/vcpkg-triplets"
        ],
        "overlay-ports": [
            "./external/vcpkg_overlays"
        ]
    }
}
