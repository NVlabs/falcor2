implementing render;

// Charlie sheen distribution and visibility from Khronos' non-normative implementation notes.
// https://github.com/KhronosGroup/glTF/blob/main/extensions/2.0/Khronos/KHR_materials_sheen/README.md#implementation-notes
// Use the distribution-roughness floor from the Enterprise PBR model referenced there.
// https://dassaultsystemes-technology.github.io/EnterprisePBRShadingModel/spec-2021x.md.html#components/sheen
namespace gltf_sheen {

[Differentiable]
float distribution_roughness(float roughness)
{
    // Enterprise's r_b is glTF's alpha_g, not artist roughness.
    return clamp(roughness * roughness, 0.07, 1.0);
}

[Differentiable]
float l(float x, float alpha_g)
{
    float one_minus_alpha_sq = (1.0 - alpha_g) * (1.0 - alpha_g);
    float a = lerp(21.5473, 25.3245, one_minus_alpha_sq);
    float b = lerp(3.82987, 3.32435, one_minus_alpha_sq);
    float c = lerp(0.19823, 0.16801, one_minus_alpha_sq);
    float d = lerp(-1.97760, -1.27393, one_minus_alpha_sq);
    float e = lerp(-4.32054, -4.85967, one_minus_alpha_sq);
    return a / (1.0 + b * pow(x, c)) + d * x + e;
}

[Differentiable]
float lambda_sheen(float cos_theta, float alpha_g)
{
    cos_theta = saturate(cos_theta);
    return cos_theta < 0.5 ? exp(l(cos_theta, alpha_g)) : exp(2.0 * l(0.5, alpha_g) - l(1.0 - cos_theta, alpha_g));
}

// Directional albedo of unit-color sheen, generated by tools/generate_gltf_sheen_energy.py.
// Rows sample distribution roughness uniformly; columns use a squared cosine grid.
// https://github.com/KhronosGroup/glTF/blob/main/extensions/2.0/Khronos/KHR_materials_sheen/README.md#albedo-scaling-technique
public float energy(float cosine, float roughness)
{
    const float size = 64.0;
    float alpha_g = distribution_roughness(roughness);
    float2 grid = float2(sqrt(saturate((abs(cosine) - 1.0e-6) / (1.0 - 1.0e-6))), (alpha_g - 0.07) / (1.0 - 0.07));
    float2 uv = (grid * (size - 1.0) + 0.5) / size;
    return gltf_scattering_globals.sheen_energy.SampleLevel(gltf_scattering_globals.sampler, uv, 0.0).r;
}

// Khronos Charlie distribution and symmetric visibility, including the outgoing
// cosine. Unlike the legacy SheenBSDF, this has no terminator-softening heuristic.
[Differentiable]
public float eval(float3 wi, float3 wo, float roughness)
{
    if (min(wi.z, wo.z) < BSDF_MIN_COS_THETA)
        return 0.0;

    float alpha_g = distribution_roughness(roughness);
    float inv_r = 1.0 / alpha_g;
    float3 h = normalize(wi + wo);
    float cos2h = h.z * h.z;
    float sin2h = saturate(1.0 - cos2h);
    float sheen_distribution = (2.0 + inv_r) * pow(sin2h, inv_r * 0.5) / (2.0 * float.PI);

    // In this local frame N = (0, 0, 1). Map V to wi and L to wo in Khronos' symmetric visibility.
    float n_dot_v = wi.z;
    float n_dot_l = wo.z;
    float sheen_visibility
        = 1.0 / ((1.0 + lambda_sheen(n_dot_v, alpha_g) + lambda_sheen(n_dot_l, alpha_g)) * (4.0 * n_dot_v * n_dot_l));

    // Enterprise uses V = G / (4*NdotV*NdotL), without the Sample Renderer's V <= 1 clamp.
    // Falcor also includes the outgoing cosine in BSDF evaluation.
    return sheen_distribution * sheen_visibility * n_dot_l;
}
}
