+@contextmanager
+def _time_reweighting(
+    node: RenderNode,
+    encoder: spy.CommandEncoder,
+    query_pool: spy.QueryPool,
+    query_index: int,
+    calls: list[int],
+) -> Iterator[None]:
+    """Bracket the historical accumulator's append and resolve as one phase."""
+    originals = {name: getattr(node, name) for name in ("accumulate", "resolve")}
+    overrides = {name: vars(node)[name] for name in originals if name in vars(node)}
+    started = False
+
+    def accumulate(*args: Any, **kwargs: Any) -> Any:
+        nonlocal started
+        if kwargs.get("cmd") is not encoder or started:
+            raise ValueError("Accumulation must execute once on the frame encoder")
+        started = True
+        encoder.write_timestamp(query_pool, query_index)
+        return originals["accumulate"](*args, **kwargs)
+
+    def resolve(*args: Any, **kwargs: Any) -> Any:
+        if kwargs.get("cmd") is not encoder or not started or calls[0]:
+            raise ValueError("Accumulation must resolve once after append on the frame encoder")
+        value = originals["resolve"](*args, **kwargs)
+        encoder.write_timestamp(query_pool, query_index + 1)
+        calls[0] += 1
+        return value
+
+    node.accumulate, node.resolve = accumulate, resolve
+    try:
+        yield
+    finally:
+        for name in originals:
+            if name in overrides:
+                setattr(node, name, overrides[name])
+            else:
+                delattr(node, name)
+
